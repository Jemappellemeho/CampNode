# ══════════════════════════════════════════
# CampNode — Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und trage deine Werte ein.
# NIEMALS echte Werte in .env.example committen!
# ══════════════════════════════════════════


# ─────────────────────────────────────────
# PostgreSQL (Docker)
# ─────────────────────────────────────────
POSTGRES_USER=campnode
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=campnode


# ─────────────────────────────────────────
# Backend — Auth
# ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_MINIMUM_32_CHARS_STRING


# ─────────────────────────────────────────
# Backend — CORS
# ─────────────────────────────────────────
# In Produktion: echte Domain, z.B. https://campnode.uni-muster.de
CORS_ORIGIN=http://localhost:5173


# ─────────────────────────────────────────
# OAuth2 / SSO (Uni-Login)
# Werte kommen von der Uni-IT
# ─────────────────────────────────────────
OAUTH2_CLIENT_ID=KOMMT_VON_UNI
OAUTH2_CLIENT_SECRET=KOMMT_VON_UNI
OAUTH2_ISSUER_URL=https://sso.uni-muster.de/realms/studenten
OAUTH2_CALLBACK_URL=https://campnode.uni-muster.de/api/auth/sso/callback


# ─────────────────────────────────────────
# Mistral (Uni self-hosted KI)
# Werte kommen von der Uni-IT
# ─────────────────────────────────────────
AI_API_KEY=KOMMT_VON_UNI_ODER_LEER_LASSEN
AI_BASE_URL=http://mistral.uni-muster.de:11434/v1
AI_CHAT_MODEL=mistral
AI_EMBED_MODEL=nomic-embed-text
AI_TIMEOUT_MS=120000


# ─────────────────────────────────────────
# Supabase (pgvector für RAG-Embeddings)
# ─────────────────────────────────────────
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=DEIN_SERVICE_ROLE_KEY
