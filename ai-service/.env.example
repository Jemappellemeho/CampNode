# ══════════════════════════════════════════
# CampNode — AI Service Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und trage deine Werte ein.
# Variablennamen identisch zur Root-.env.example und docker-compose.yml.
# ══════════════════════════════════════════

# KI-Provider (Uni self-hosted Mistral — OpenAI-kompatibler Endpoint)
AI_API_KEY=KOMMT_VON_UNI_ODER_LEER_LASSEN
AI_BASE_URL=http://mistral.uni-muster.de:11434/v1
AI_CHAT_MODEL=mistral
AI_EMBED_MODEL=nomic-embed-text

# Internes Shared Secret (muss identisch zum Backend sein).
# Schützt /ask und /ingest vor direkten Aufrufen von außen.
INTERNAL_AI_SECRET=CHANGE_ME_SHARED_SECRET

# Supabase Konfiguration (für pgvector RAG-Embeddings)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
