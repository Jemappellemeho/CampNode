# ══════════════════════════════════════════
# CampNode — Backend Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und trage deine Werte ein.
# ══════════════════════════════════════════

# Server-Konfiguration
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Prisma-Datenbankzugriff
# DATABASE_URL: Verbindungs-URL (für connection pooling z.B. Port 6543 bei Supabase)
# DIRECT_URL: Direkte Verbindung zur DB (für Migrationen z.B. Port 5432)
DATABASE_URL="postgresql://postgres.USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.USER:PASSWORD@HOST:5432/postgres"

# Authentifizierung & JWT
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_MINIMUM_32_CHARS_STRING

# AI Service Verbindung
AI_SERVICE_URL=http://localhost:8001

# Internes Shared Secret für die Calls an den ai-service (B3 / A4).
# Muss identisch zum INTERNAL_AI_SECRET des ai-service sein.
INTERNAL_AI_SECRET=CHANGE_ME_SHARED_SECRET

# AI Provider Einstellungen
AI_PROVIDER=YourAIService
AI_TIMEOUT_MS=180000
AI_MAX_INPUT_CHARS=6500
QUIZ_REPAIR_ENABLED=false

