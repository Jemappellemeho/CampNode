generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String
  role            Role       @default(STUDENT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  courses         Course[]   @relation("InstructorCourses")
  progress        Progress[]
  enrolledCourses Course[]   @relation("EnrolledCourses")
}

model Course {
  id           String   @id @default(uuid())
  title        String
  description  String?
  joinCode     String   @unique
  instructorId String
  createdAt    DateTime @default(now())
  isPublic     Boolean  @default(false)
  instructor   User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  topics       Topic[]
  students     User[]   @relation("EnrolledCourses")
}

model Topic {
  id             String     @id @default(uuid())
  name           String
  description    String?
  courseId       String?
  content        String?
  wikidataId     String?
  wikipediaTitle String?
  progress       Progress[]
  quizzes        Quiz[]
  course         Course?    @relation(fields: [courseId], references: [id])
  parentTopicId  String?
  order          Int        @default(0)
  aiSuggested    Boolean    @default(false)
  videoUrl       String?
  articleUrl     String?
  podcastUrl     String?
  parentTopic    Topic?     @relation("Subtopics", fields: [parentTopicId], references: [id])
  subtopics      Topic[]    @relation("Subtopics")
  Topic_A        Topic[]    @relation("TopicHierarchy")
  Topic_B        Topic[]    @relation("TopicHierarchy")
}

model Quiz {
  id        String   @id @default(uuid())
  topicId   String
  questions Json
  createdAt DateTime @default(now())
  topic     Topic    @relation(fields: [topicId], references: [id])
}

model Progress {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  topic     Topic    @relation(fields: [topicId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, topicId])
}

enum Role {
  STUDENT
  PROFESSOR
}
